# ─────────────────────────────────────────────────────────────────────────────
# RAG Application — Environment Variables
# Copy this file to .env and set your values.
# The .env file is gitignored and must NOT be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Groq LLM settings ─────────────────────────────────────────────────────────
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_api_key_here

# ── Embedding settings ────────────────────────────────────────────────────────
# HuggingFace sentence-transformers model name
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K=3

# ── Storage (relative to project root) ───────────────────────────────────────
DATA_DIR=data
VECTORSTORE_DIR=vectorstore

# ── CORS (comma-separated allowed origins for the FastAPI backend) ────────────
CORS_ORIGINS=http://localhost:8501

# ── Frontend Configuration ─────────────────────────────────────────────────────
# Point Streamlit to the FastAPI URL. On Render, set this to your Render URL.
BACKEND_URL=http://localhost:8000
